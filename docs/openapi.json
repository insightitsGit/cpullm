  },
  "components": {
    "securitySchemes": {
      "BearerSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "Send the original credential secret, not its SHA256 digest. Server stores secret_sha256 and maps tenant/caller/source scope."
      }
    },
    "schemas": {
      "AskRequest": {
        "type": "object",
        "required": [
          "message"
        ],
        "additionalProperties": true,
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "English request. Explicit tone directives are parsed from this text."
          },
          "discover": {
            "type": "boolean"
          },
          "imagine": {
            "type": "boolean"
          },
          "deep": {
            "type": "boolean"
          },
          "math": {
            "type": "boolean"
          },
          "finance": {
            "type": "boolean"
          },
          "strict_evidence": {
            "type": "boolean"
          },
          "small_talk": {
            "type": "boolean"
          },
          "as_of": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Epoch-seconds historical validity time."
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "cycle_search": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seed"
            ],
            "properties": {
              "seed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_rounds": {
                    "type": "integer",
                    "default": 1000,
                    "maximum": 100000,
                    "minimum": 1
                  },
                  "max_nodes": {
                    "type": "integer",
                    "default": 10000,
                    "maximum": 100000,
                    "minimum": 1
                  },
                  "max_edges": {
                    "type": "integer",
                    "default": 50000,
                    "maximum": 200000,
                    "minimum": 1
                  },
                  "max_states": {
                    "type": "integer",
                    "default": 100000,
                    "maximum": 200000,
                    "minimum": 1
                  },
                  "max_frontier": {
                    "type": "integer",
                    "default": 10000,
                    "maximum": 100000,
                    "minimum": 1
                  },
                  "max_cycles": {
                    "type": "integer",
                    "default": 32,
                    "maximum": 100,
                    "minimum": 1
                  },
                  "max_bytes": {
                    "type": "integer",
                    "default": 67108864,
                    "maximum": 134217728,
                    "minimum": 1
                  },
                  "max_seconds": {
                    "type": "number",
                    "default": 5.0,
                    "maximum": 60,
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "description": "Explicit bounded lexical cycle discovery with verified path sentence composition; standalone or inside a document. API options override prompt seed. Strict mode disables cycles; no shortcut inference."
          },
          "invent": {
            "type": "boolean",
            "default": false,
            "description": "Opt in to taxonomy-driven invention. The response labels proposals as hypotheses and discloses possible variability. Strict evidence disables this path."
          },
          "nammade": {
            "type": "boolean",
            "default": false,
            "description": "Opt in to the Nammade equilibrium scan over the caller's authorized spans. The reply quotes spans and reports channel labels. Strict evidence disables this path."
          },
          "nammade_kappa": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Positive finite volumetric stiffness used by an explicit Nammade scan. The default is 1."
          },
          "deepen": {
            "description": "Opt in to the Deepen node for one hypothesis: evidence for and against each link, source predictions, existing setups, confounders and a test plan. Pass the hypothesis text (Frontier forms or plain forms such as 'A may reduce C', 'A limits C via B', 'C may grow exponentially with A'), a hypothesis object from a Frontier receipt, true to read the message as the hypothesis, or an envelope {hypothesis, definitions, protocol, novelty, external_review, axiom_sources}. definitions[term] may set measurement, unit, levels, feasible and type (intervention, observable_property, noise_channel, outcome_metric, unknown). The receipt carries lead_status (testable, needs_semantic_resolution, contested_tension, coverage_gap, insufficient_evidence, needs_review, incomplete); contested and meaning-mismatched leads get a resolve_first plan instead of an experiment. external_review calls an operator-registered literature reviewer (for example cpu_llm.literature_arxiv.ArxivReviewer) and reports prior_art_status. Malformed hypothesis objects request clarification. Shared budget expiry produces partial output with an incomplete receipt. Results stay unverified and are never written to the index. Strict evidence disables this path.",
            "oneOf": [{"type": "boolean"}, {"type": "string", "minLength": 1}, {"type": "object"}]
          },
          "frontier": {
            "description": "Opt in to the Frontier node: 10 to 50 ranked UNVERIFIED_HYPOTHESIS entries (hard cap 50) built from relation combinations across the caller's authorized snapshot. true uses default budgets; an object may name the topic and limits. Results are never promoted or written to the index. Strict evidence disables this path.",
            "oneOf": [
              {"type": "boolean", "default": false},
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "topic": {"type": "string", "minLength": 1, "maxLength": 240},
                  "deepen_top": {"type": "integer", "default": 5, "minimum": 0, "maximum": 10, "description": "Run Deepen on this many leading entries and mark each with its verdict and lead_status; 0 turns the check off. With checks requested, candidate generation stops at 80% of max_seconds (stop_reason generation_time_reserved)."},
                  "screen": {"description": "Drop generic entries (no term names the topic, or an off-topic term spans at least 8% of chunks, with relevance below 0.8), rank by 0.6 x relevance + 0.4 x novelty, and check the shortlist with Deepen's novelty review.", "oneOf": [{"type": "boolean"}, {"type": "object", "additionalProperties": false, "properties": {"shortlist": {"type": "integer", "default": 15, "minimum": 5, "maximum": 30}}}]},
                  "axiom_sources": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 120}, "description": "Source prefixes holding background knowledge; candidates built only from them are dropped and they do not count toward novelty."},
                  "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "max_rounds": {"type": "integer", "default": 1000, "minimum": 1, "maximum": 100000},
                      "max_candidates": {"type": "integer", "default": 200000, "minimum": 1, "maximum": 2000000},
                      "max_edges": {"type": "integer", "default": 50000, "minimum": 1, "maximum": 200000},
                      "max_bytes": {"type": "integer", "default": 67108864, "minimum": 1, "maximum": 134217728},
                      "max_seconds": {"type": "number", "default": 60, "exclusiveMinimum": 0, "maximum": 120},
                      "batch_size": {"type": "integer", "default": 256, "minimum": 1, "maximum": 10000},
                      "max_path_edges": {"type": "integer", "default": 2, "minimum": 2, "maximum": 3},
                      "max_results": {"type": "integer", "default": 50, "minimum": 1, "maximum": 50},
                      "min_results": {"type": "integer", "default": 10, "minimum": 1, "maximum": 50}
                    }
                  }
                }
              }
            ]
          },
          "target_level": {
            "type": "string",
            "enum": ["off", "auto", "A1", "A2", "B1", "B2", "C1", "C2"],
            "description": "Opt-in display vocabulary policy. Requires the server's --prismlexicon switch."
          },
          "inference": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "relation",
                  "object"
                ],
                "properties": {
                  "mode": {
                    "const": "deductive"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "relation": {
                    "enum": [
                      "bigger_than",
                      "has",
                      "member_of",
                      "subclass_of",
                      "physical_part_of",
                      "physically_contains",
                      "located_in",
                      "requires"
                    ]
                  },
                  "object": {
                    "type": "string"
                  },
                  "max_hops": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 4
                  },
                  "max_predicates": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256,
                    "default": 256
                  },
                  "max_states": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024,
                    "default": 1024
                  },
                  "max_operations": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000,
                    "default": 100000
                  }
                },
                "description": "Explicit service deduction using source-bound predicates and registered rules. Strict Evidence Mode refuses derived inference. Combining an explicit inference request with conflicting specialist API flags raises a validation error (HTTP 400). Ordinary questions can attach receipts from retrieved evidence without a full-snapshot inference fetch."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "source_ids"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "temporal",
                      "inductive",
                      "abductive"
                    ]
                  },
                  "source_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[\\w.-]{1,200}$"
                    }
                  }
                },
                "description": "Opt-in analysis of selected authorized chunks containing inference-record-v1 JSON. Temporal calculations, Wilson statistical estimates and unverified explanation alternatives have distinct claim statuses; strict mode refuses them."
              }
            ]
          }
        },
        "description": "Supported request fields. Unknown keys are ignored, including style; pass tone in message text. Current runtime coerces message to a string and enforces strict_evidence/small_talk boolean types; this schema describes recommended client types, not a claim of universal runtime schema enforcement."
      },
      "AskResponse": {
        "type": "object",
        "additionalProperties": true,
        "description": "Polymorphic result: inspect answer_status, per-task outcomes, evidence and judgment; HTTP 200 is not factual or clinical approval.",
        "properties": {
          "answer_status": {
            "type": "string"
          },
          "audit_passed": {
            "type": "boolean"
          },
          "answer_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "reply": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "text": {
                "type": "string"
              }
            }
          },
          "document": {
            "type": "object",
            "additionalProperties": true
          },
          "stylistic": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "IngestRequest": {
        "type": "object",
        "additionalProperties": true,
        "anyOf": [
          {
            "required": [
              "name",
              "paragraphs"
            ]
          },
          {
            "required": [
              "source"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        },
        "description": "Document body or server path under configured ingest_root. When paragraphs is an array it takes precedence over source."
      },
      "CorrectRequest": {
        "type": "object",
        "required": [
          "document_id",
          "prior_sentence",
          "new_sentence",
          "actor_id",
          "timestamp"
        ],
        "additionalProperties": true,
        "properties": {
          "document_id": {
            "type": "string"
          },
          "prior_sentence": {
            "type": "string"
          },
          "new_sentence": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "description": "Epoch seconds for versioned correction."
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "OperationResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
