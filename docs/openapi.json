{
  "openapi": "3.1.0",
  "info": {
    "title": "CPU LLM authenticated HTTP contract",
    "version": "1.11.2-source",
    "description": "Documentation for the stdlib Entry-backed server. This file is checked in; 1.11.0 does not serve /openapi.json, Swagger UI, TLS or a production gateway. Operator strict floors and small-talk disables take precedence. Optional Python style/realization controls are not HTTP fields. Source patch 1.11.1 serializes requests on the serving thread and closes response connections. Entry factories must lazily create thread-affine appliances there. Published 1.11.0 threaded transport has a cross-client SQLite affinity defect. Unreleased source addition: explicit cycle_search opts into bounded lexical cycle discovery; strict mode disables it."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/v1/ask": {
      "post": {
        "operationId": "ask",
        "security": [
          {
            "BearerSecret": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              },
              "examples": {
                "ordinaryDocument": {
                  "value": {
                    "message": "Write a detailed article about Helios in a friendly tone."
                  }
                },
                "strictDocument": {
                  "value": {
                    "message": "Write a detailed report about Helios in a friendly tone.",
                    "strict_evidence": true
                  }
                },
                "strictLookup": {
                  "value": {
                    "message": "What is the strength of Fictional DemoMed?",
                    "strict_evidence": true,
                    "small_talk": false
                  }
                },
                "cyclePrompt": {
                  "summary": "Natural-language cycle trigger",
                  "value": {
                    "message": "Show relationship loops for Alpha."
                  }
                },
                "documentCycles": {
                  "summary": "Research report consuming cycle evidence from the same snapshot",
                  "value": {
                    "message": "Write a detailed report about Alpha, including relationship loops through Alpha."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation envelope; inspect semantic status separately.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Typed transport error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Typed transport error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Typed transport error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Typed transport error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Typed transport error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CPU-LLM-Evidence-Mode",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "strict",
                "standard"
              ]
            },
            "description": "strict enables evidence policy; standard cannot override body strict=true or an operator strict floor."
          }
        ]
      }
    },
    "/v1/ingest": {
