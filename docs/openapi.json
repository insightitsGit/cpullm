  "components": {
    "securitySchemes": {
      "BearerSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "Send the original credential secret, not its SHA256 digest. Server stores secret_sha256 and maps tenant/caller/source scope."
      }
    },
    "schemas": {
      "AskRequest": {
        "type": "object",
        "required": [
          "message"
        ],
        "additionalProperties": true,
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "English request. Explicit tone directives are parsed from this text."
          },
          "discover": {
            "type": "boolean"
          },
          "imagine": {
            "type": "boolean"
          },
          "deep": {
            "type": "boolean"
          },
          "math": {
            "type": "boolean"
          },
          "finance": {
            "type": "boolean"
          },
          "strict_evidence": {
            "type": "boolean"
          },
          "small_talk": {
            "type": "boolean"
          },
          "as_of": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Epoch-seconds historical validity time."
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "cycle_search": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seed"
            ],
            "properties": {
              "seed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_rounds": {
                    "type": "integer",
                    "default": 1000,
                    "maximum": 100000,
                    "minimum": 1
                  },
                  "max_nodes": {
                    "type": "integer",
                    "default": 10000,
                    "maximum": 100000,
                    "minimum": 1
                  },
                  "max_edges": {
                    "type": "integer",
                    "default": 50000,
                    "maximum": 200000,
                    "minimum": 1
                  },
                  "max_states": {
                    "type": "integer",
                    "default": 100000,
                    "maximum": 200000,
                    "minimum": 1
                  },
                  "max_frontier": {
                    "type": "integer",
                    "default": 10000,
                    "maximum": 100000,
                    "minimum": 1
                  },
                  "max_cycles": {
                    "type": "integer",
                    "default": 32,
                    "maximum": 100,
                    "minimum": 1
                  },
                  "max_bytes": {
                    "type": "integer",
                    "default": 67108864,
                    "maximum": 134217728,
                    "minimum": 1
                  },
                  "max_seconds": {
                    "type": "number",
                    "default": 5.0,
                    "maximum": 60,
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "description": "Explicit bounded lexical cycle discovery with verified path sentence composition; standalone or inside a document. API options override prompt seed. Strict mode disables cycles; no shortcut inference."
          },
          "invent": {
            "type": "boolean",
            "default": false,
            "description": "Opt in to taxonomy-driven invention. The response labels proposals as hypotheses and discloses possible variability. Strict evidence disables this path."
          }
        },
        "description": "Supported request fields. Unknown keys are ignored, including style; pass tone in message text. Current runtime coerces message to a string and enforces strict_evidence/small_talk boolean types; this schema describes recommended client types, not a claim of universal runtime schema enforcement."
      },
      "AskResponse": {
        "type": "object",
        "additionalProperties": true,
        "description": "Polymorphic result: inspect answer_status, per-task outcomes, evidence and judgment; HTTP 200 is not factual or clinical approval.",
        "properties": {
          "answer_status": {
            "type": "string"
          },
          "audit_passed": {
            "type": "boolean"
          },
          "answer_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "reply": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "text": {
                "type": "string"
              }
            }
          },
          "document": {
            "type": "object",
            "additionalProperties": true
          },
          "stylistic": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "IngestRequest": {
        "type": "object",
        "additionalProperties": true,
        "anyOf": [
          {
            "required": [
              "name",
              "paragraphs"
            ]
          },
          {
            "required": [
              "source"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        },
        "description": "Document body or server path under configured ingest_root. When paragraphs is an array it takes precedence over source."
      },
      "CorrectRequest": {
        "type": "object",
        "required": [
          "document_id",
          "prior_sentence",
          "new_sentence",
          "actor_id",
          "timestamp"
        ],
        "additionalProperties": true,
        "properties": {
          "document_id": {
            "type": "string"
          },
          "prior_sentence": {
            "type": "string"
          },
          "new_sentence": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "description": "Epoch seconds for versioned correction."
          }
        }
      },
      "DeleteRequest": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      },
      "OperationResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
